// test functions

fun TimesTwo[Value] {
    Answer := Value * 2;
    if [Value > 100] {
        Answer := Answer - 100;
    }
    return Answer;
}

BaseWidth := 10px;
Amount := 6;

p {
    width: CalcWidth[BaseWidth, Amount];
    height: TimesTwo[30%];
}

fun CalcWidth[Width, Times] {
    Result := Width * Times;
    return TimesTwo[Result];
}


/*
Expected output:

p {
    width: 20px;
    height: 60%;
}
*/